<?xml version="1.0" encoding="utf-8"?>
<!--
Rendered by write_fix_config() in lineaje_scan_gh.py into <veecli dir>/lineaje-verify.nuget.config.
Double-underscore placeholders are substituted at write time.

Contains no raw credentials: the password is a NuGet %ENV_VAR% reference,
resolved by NuGet itself from the verify hook's environment
(ARTIFACTORY_NUGET_TOKEN) - same principle as lineaje-verify.npmrc's
${ARTIFACTORY_NPM_TOKEN} expansion. Still written chmod 600 and never logged.

Public packages resolve from nuget.org; Lineaje-rebuilt versions only exist in
the GOS premium feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="gos-premium-nuget" value="__FEED_URL__" />
  </packageSources>
  <packageSourceCredentials>
    <gos-premium-nuget>
      <add key="Username" value="__USERNAME__" />
      <add key="ClearTextPassword" value="%ARTIFACTORY_NUGET_TOKEN%" />
    </gos-premium-nuget>
  </packageSourceCredentials>
</configuration>
